# Робоче середовище (production).
# Створіть робочий файл командою: python scripts/init_env.py
# Файл .env.production не комітиться в git. На хостингу ці змінні задаються в панелі керування.

APP_ENV=production
# Режим відладки в production заборонений — застосунок не запуститься з DEBUG=true
DEBUG=false
DOCS_ENABLED=false
LOG_LEVEL=INFO

# Окрема база для робочого середовища.
# Локально — окремий файл SQLite; на сервері — PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/vet_crm
DATABASE_URL=sqlite+aiosqlite:///./vet_crm_production.db

# Окремий секретний ключ, НЕ такий як у sandbox. Генерується скриптом init_env.py
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Необов'язково: створити адміністратора при старті
ADMIN_EMAIL=
ADMIN_PASSWORD=
