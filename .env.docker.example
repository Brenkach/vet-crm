# Налаштування для запуску в Docker (docker compose up --build).
# Створіть робочий файл .env командою: python scripts/init_env.py
# Файл .env не комітиться в git.

# ---------- База даних (контейнер db) ----------
POSTGRES_USER=vet_crm
POSTGRES_PASSWORD=
POSTGRES_DB=vet_crm

# ---------- Застосунок (контейнер app) ----------
APP_ENV=production
DEBUG=false
DOCS_ENABLED=false
LOG_LEVEL=INFO
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------- Балансування (контейнер nginx) ----------
# Порт Nginx на вашому комп'ютері: http://localhost (якщо 80 зайнятий — наприклад, 8080)
HTTP_PORT=80
# Кількість реплік застосунку за балансувальником
APP_REPLICAS=3
# Алгоритм: round_robin | least_conn | ip_hash
LB_ALGORITHM=round_robin

# Адміністратор, який створюється при першому запуску
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
