# Тестове середовище (sandbox).
# Створіть робочий файл командою: python scripts/init_env.py
# Файл .env.sandbox не комітиться в git.

APP_ENV=sandbox
DEBUG=true
DOCS_ENABLED=true
LOG_LEVEL=DEBUG

# Окрема база для тестового середовища
DATABASE_URL=sqlite+aiosqlite:///./vet_crm_sandbox.db

# Секретний ключ для JWT (мінімум 32 символи). Генерується скриптом init_env.py
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Пароль демо-користувачів для python -m app.seed. Генерується скриптом init_env.py
SEED_USER_PASSWORD=

# Необов'язково: створити адміністратора при старті
ADMIN_EMAIL=
ADMIN_PASSWORD=
